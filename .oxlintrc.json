{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "react"],
	"categories": {
		"correctness": "error"
	},
	"rules": {
		"react/rules-of-hooks": "error",
		"react/exhaustive-deps": "error"
	},
	"ignorePatterns": [
		"**/node_modules/**",
		"**/dist/**",
		"**/dist-ssr/**",
		"**/build/**",
		"**/coverage/**",
		"**/.expo/**",
		"**/web-build/**",
		"**/src-tauri/target/**",
		"**/src-tauri/gen/**",
		"apps/expo/ios/**",
		"apps/expo/android/**",
		"apps/expo/expo-env.d.ts",
		"**/uniwind-types.d.ts",
		"**/vite-env.d.ts"
	]
}
