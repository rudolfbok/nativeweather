{
	"name": "@nativeweather/core",
	"version": "0.0.0",
	"private": true,
	"exports": {
		"./*": "./src/*.ts",
		"./locales/*.json": "./src/locales/*.json",
		"./hooks/location/useLocation": {
			"react-native": {
				"macos": "./src/hooks/location/useLocation.macos.ts",
				"default": "./src/hooks/location/useLocation.ts"
			},
			"default": "./src/hooks/location/useLocation.web.ts"
		}
	},
	"dependencies": {
		"@nativeweather/types": "workspace:*",
		"react-native-mmkv": "4.3.1",
		"@nativeweather/api": "workspace:*",
		"expo-location": "~58.0.17",
		"luxon": "^3.7.2",
		"zustand": "^5.0.9"
	},
	"peerDependencies": {
		"react": "19.0.0 || ^19.2.0",
		"react-native": "0.79.6 || 0.83.10 || 0.86.2 || 0.88.0"
	},
	"scripts": {
		"lint": "oxlint --config ../../.oxlintrc.json .",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"typescript": "^5.9.3",
		"@types/luxon": "^3.7.5",
		"@types/react": "~19.2.14"
	}
