{
	"name": "nativeweather",
	"version": "2.0.0",
	"private": true,
	"scripts": {
		"lint": "pnpm --recursive --if-present run lint",
		"lint:fix": "pnpm --recursive run lint:fix",
		"typecheck": "pnpm --recursive --if-present run typecheck",
		"format": "oxfmt",
		"dev:expo": "pnpm --filter @nativeweather/expo start",
		"dev:tauri": "pnpm --filter nativeweather-tauri dev",
		"dev:web": "pnpm --filter @nativeweather/expo web",
		"dev:api": "pnpm --filter @nativeweather/api-worker dev",
		"dev:site": "pnpm --filter @nativeweather/site dev",
		"build:tauri": "pnpm --filter nativeweather-tauri build",
		"build:web": "pnpm --filter @nativeweather/expo build",
		"build:site": "pnpm --filter @nativeweather/site build",
		"preview:web": "pnpm build:web && pnpm --filter @nativeweather/worker dev",
		"deploy:web": "pnpm build:web && pnpm --filter @nativeweather/worker run deploy",
		"deploy:site": "pnpm --filter @nativeweather/site run deploy",
		"deploy:api": "pnpm --filter @nativeweather/api-worker run deploy",
		"deploy:site:preview": "pnpm --filter @nativeweather/site run deploy:preview"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.9.1",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.9.1",
	"type": "module",
	"devDependencies": {
		"oxfmt": "^0.78.0",
		"oxlint": "^1.91.0"
	}
}
