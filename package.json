{
  "name": "nativeweather",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "pnpm --recursive --if-present run lint",
    "lint:fix": "pnpm --recursive run lint:fix",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "build": "pnpm --filter nativeweather-mobile build && pnpm --filter nativeweather-desktop build",
    "dev:desktop": "pnpm --filter nativeweather-desktop dev",
    "dev:mobile": "pnpm --filter nativeweather-mobile start",
    "dev:web": "pnpm --filter nativeweather-mobile exec expo start --web --port 8081",
    "tauri": "pnpm --filter nativeweather-desktop exec tauri dev",
    "expo": "pnpm --filter nativeweather-mobile run start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "devDependencies": {
    "oxlint": "^1.91.0"
  }
}
