{
	"name": "nativeweather",
	"version": "1.0.0",
	"description": "NativeWeather monorepo Expo and NextJS",
	"main": "index.js",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"lint": "turbo lint",
		"format": "prettier --write .",
		"typecheck": "turbo typecheck",
		"dev:web": "turbo run dev --filter=nativeweather-web",
		"dev:mobile": "turbo run dev --filter=nativeweather-mobile",
		"dev:macos": "stmux -- [ \"turbo run dev --filter=nativeweather-macos\" .. \"wait-on tcp:localhost:8081 && turbo run macos --filter=nativeweather-macos\" ]",
		"build:web": "turbo run build --filter=nativeweather-web",
		"build:ios": "turbo run build:ios --filter=nativeweather-mobile",
		"build:android": "turbo run build:android --filter=nativeweather-mobile",
		"build:macos": "turbo run build:macos --filter=nativeweather-macos",
		"deploy": "turbo run deploy --filter=nativeweather-web"
	},
	"keywords": [],
	"author": "Rudolf Bok",
	"packageManager": "pnpm@12.6.0",
	"devDependencies": {
		"oxlint": "^1.86.0",
		"prettier": "^3.9.5",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"stmux": "^2.0.0",
		"turbo": "^2.11.5",
		"wait-on": "^9.0.10"
	}
}
