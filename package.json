{
	"name": "nativeweather",
	"version": "1.0.0",
	"description": "NativeWeather monorepo Expo and NextJS",
	"main": "index.js",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"lint": "turbo lint",
		"format": "prettier --write .",
		"typecheck": "turbo typecheck",
		"web": "cd apps/web && turbo dev",
		"mobile": "cd apps/mobile && turbo dev",
		"macos": "cd apps/macos && stmux -- [ \"turbo dev\" .. \"wait-on tcp:localhost:8081 && pnpm macos\" ]",
		"deploy": "cd apps/web && opennextjs-cloudflare build && opennextjs-cloudflare deploy"
	},
	"keywords": [],
	"author": "Rudolf Bok",
	"packageManager": "pnpm@10.26.2",
	"devDependencies": {
		"prettier": "^3.9.5",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"stmux": "^2.0.0",
		"turbo": "^2.7.2",
		"wait-on": "^9.0.10"
	}
}
