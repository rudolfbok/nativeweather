{
	"$schema": "./node_modules/turbo/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULTS$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"]
		},
		"web#build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULTS$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**", ".open-next/**"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"dev": {
			"persistent": true,
			"cache": false
		}
	}
}
