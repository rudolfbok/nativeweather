{
	"expo": {
		"name": "NativeWeather",
		"slug": "nativeweather",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "mobile",
		"userInterfaceStyle": "automatic",
		"ios": {
			"icon": "./assets/images/icon.png",
			"supportsTablet": true,
			"bundleIdentifier": "com.rudyxsides.nativeweather",
			"infoPlist": {
				"NSLocationWhenInUseUsageDescription": "NativeWeather needs your location to show the local weather forecast."
			}
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/icon.png",
				"backgroundColor": "#ffffff"
			},
			"package": "com.rudyxsides.nativeweather"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#007AFF"
				}
			],
			[
				"expo-widgets",
				{
					"bundleIdentifier": "com.rudyxsides.nativeweather.ExpoWidgetsTarget",
					"groupIdentifier": "group.com.rudyxsides.nativeweather",
					"widgets": [
						{
							"name": "SmallLocal",
							"displayName": "Curret temperature",
							"description": "See how is the weather right now",
							"contentMarginsDisabled": true,
							"supportedFamilies": ["systemSmall"]
						},
						{
							"name": "MediumLocal",
							"displayName": "Local widget",
							"description": "Local weather with hourly forecast",
							"contentMarginsDisabled": true,
							"supportedFamilies": ["systemMedium"]
						},
						{
							"name": "SmallAQI",
							"displayName": "Current air quality",
							"description": "Local air quality index",
							"contentMarginsDisabled": true,
							"supportedFamilies": ["systemSmall"]
						},
						{
							"name": "MediumAQI",
							"displayName": "Local air quality",
							"description": "Local air quality metrics",
							"contentMarginsDisabled": true,
							"supportedFamilies": ["systemMedium"]
						}
					]
				}
			],
			"expo-font",
			"expo-web-browser",
			"@maplibre/maplibre-react-native",
			"expo-build-properties"
		],
		"experiments": {
			"typedRoutes": false
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "9bed5f57-4fbe-412e-a893-d89e1129bf8b"
			}
		}
	}
}
