{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"@/*": ["./*"],
			"app/*": ["../../packages/app/*"],
			"react-native": ["../../node_modules/react-native"],
			"react-native/*": ["../../node_modules/react-native/*"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx", "babel.config.js", "nativewind-env.d.ts"]
}
