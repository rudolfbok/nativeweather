{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"@/*": ["./*"],
			"@nativeweather/ui/*": ["../../packages/ui/src/*"],
			"@nativeweather/core/*": ["../../packages/core/src/*"],
			"@nativeweather/api/*": ["../../packages/api/src/*"],
			"@nativeweather/types/*": ["../../packages/types/src/*"],
			"react-native": ["./node_modules/react-native/types_generated/index.d.ts"],
			"react-native/*": ["./node_modules/react-native/types_generated/*"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx", "babel.config.js", "nativewind-env.d.ts", "../../packages/ui/src/global.d.ts"]
}
