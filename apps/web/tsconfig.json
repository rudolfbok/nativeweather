{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": false,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"paths": {
			"@nativeweather/ui/*": ["../../packages/ui/src/*"],
			"@nativeweather/core/*": ["../../packages/core/src/*"],
			"@nativeweather/api/*": ["../../packages/api/src/*"],
			"@nativeweather/types/*": ["../../packages/types/src/*"],
		},
		"plugins": [
			{
				"name": "next"
			}
		],
		"jsxImportSource": "nativewind",
		"types": ["nativewind/types"]
	},
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "../../packages/ui/src/global.d.ts"],
	"exclude": ["node_modules", ".next/dev/types"]
}
