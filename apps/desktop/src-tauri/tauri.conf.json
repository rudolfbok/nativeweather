{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "NativeWeather",
	"mainBinaryName": "NativeWeather",
	"version": "0.1.0",
	"identifier": "com.bitwebs.nativeweather",
	"build": {
		"devUrl": "http://localhost:8081",
		"beforeBuildCommand": "pnpm --filter @nativeweather/expo build",
		"frontendDist": "../../expo/dist"
	},
	"app": {
		"windows": [
			{
				"title": "NativeWeather",
				"width": 1164,
				"height": 786,
				"minWidth": 1024,
				"minHeight": 640,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"trafficLightPosition": { "x": 18, "y": 29 }
			}
		],
		"security": {
			"csp": {
				"default-src": "'self'",
				"script-src": "'self'",
				"style-src": "'self' 'unsafe-inline'",
				"img-src": "'self' data: blob:",
				"font-src": "'self' data:",
				"worker-src": "blob:",
				"connect-src": "'self' ipc: http://ipc.localhost https://nativeweather-api.bitwebs.workers.dev https://nativeweather-email.bitwebs.workers.dev https://air-quality-api.open-meteo.com https://tiles.openfreemap.org https://weathermaps.weatherapi.com"
			},
			"devCsp": {
				"default-src": "'self'",
				"script-src": "'self' http://localhost:8081",
				"style-src": "'self' 'unsafe-inline' http://localhost:8081",
				"img-src": "'self' data: blob: http://localhost:8081",
				"font-src": "'self' data: http://localhost:8081",
				"worker-src": "blob:",
				"connect-src": "'self' ipc: http://ipc.localhost https://nativeweather-api.bitwebs.workers.dev https://nativeweather-email.bitwebs.workers.dev https://air-quality-api.open-meteo.com https://tiles.openfreemap.org https://weathermaps.weatherapi.com http://localhost:8081 ws://localhost:8081"
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"macOS": {
			"entitlements": "Entitlements.plist"
		}
	}
}
