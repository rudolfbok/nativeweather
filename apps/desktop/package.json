{
	"name": "nativeweather-macos",
	"version": "1.0",
	"private": true,
	"scripts": {
		"dev": "react-native start --port 8081",
		"build:macos": "xcodebuild -workspace macos/nativeweather.xcworkspace -scheme nativeweather -configuration Release -destination 'platform=macOS,arch=arm64' -derivedDataPath build ARCHS=arm64 build && mkdir -p release && rm -rf release/nativeweather.app && ditto build/Build/Products/Release/nativeweather.app release/nativeweather.app",
		"macos": "react-native run-macos --scheme nativeweather",
		"format": "prettier --write .",
		"lint": "oxlint --config ../../.oxlintrc.json .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@babel/runtime": "^7.25.0",
		"@nativeweather/ui": "workspace:*",
		"@nativeweather/core": "workspace:*",
		"nativewind": "4.2.6",
		"react": "19.2.0",
		"react-native": "0.83.10",
		"react-native-css-interop": "0.2.6",
		"react-native-macos": "0.83.0",
		"react-native-mmkv": "4.3.1",
		"react-native-nitro-modules": "0.35.4",
		"react-native-reanimated": "4.6.0",
		"react-native-svg": "15.16.0",
		"react-native-worklets": "0.12.2",
		"react-native-webview": "13.16.0",
		"@nativeweather/types": "workspace:*",
		"@tolgee/react": "^6.2.7",
		"clsx": "^2.1.1",
		"lucide-react-native": "^0.562.0",
		"@react-navigation/native": "^7.1.6"
	},
	"devDependencies": {
		"@babel/core": "^7.25.2",
		"@react-native-community/cli": "20.0.2",
		"@react-native-community/cli-platform-ios": "20.0.2",
		"@react-native/babel-preset": "0.83.10",
		"@react-native/metro-config": "0.83.10",
		"@react-native/typescript-config": "0.83.10",
		"@types/react": "19.2.14",
		"tailwindcss": "^3.4.18",
		"typescript": "^5.9.3",
		"metro-source-map": "0.83.8",
		"metro-transform-worker": "0.83.8",
		"metro-config": "0.83.8"
	},
	"engines": {
		"node": ">=20.19.4"
	}
}
