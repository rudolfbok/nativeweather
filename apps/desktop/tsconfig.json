{
	"extends": "@react-native/typescript-config",
	"compilerOptions": {
		"strict": false,
		"lib": [
			"esnext",
			"dom"
		],
		"types": [
			"react-native"
		],
		"paths": {
			"react-native": [
				"./node_modules/react-native"
			],
			"react-native/*": [
				"./node_modules/react-native/*"
			],
			"@nativeweather/ui/*": [
				"../../packages/ui/src/*"
			],
			"@nativeweather/core/*": [
				"../../packages/core/src/*"
			],
			"@nativeweather/api/*": [
				"../../packages/api/src/*"
			],
			"@nativeweather/types/*": [
				"../../packages/types/src/*"
			]
		}
	},
	"include": [
		"**/*",
		"../../packages/ui/src/global.d.ts",
		"nativewind-env.d.ts"
	]
}
