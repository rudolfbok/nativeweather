{
	"extends": "@react-native/typescript-config",
	"compilerOptions": {
		"strict": false,
		"lib": [
			"esnext",
			"dom"
		],
		"types": [
			"react-native"
		],
		"customConditions": ["react-native", "macos"],
		"paths": {
			"react-native": [
				"./node_modules/react-native"
			],
			"react-native/*": [
				"./node_modules/react-native/*"
			]
		}
	},
	"include": [
		"**/*",
		"../../packages/ui/src/global.d.ts",
		"nativewind-env.d.ts"
	]
}
