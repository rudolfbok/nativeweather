{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "lib": [
      "esnext",
      "dom"
    ],
    "types": [
      "react-native"
    ],
    "paths": {
      "app/*": [
        "../../packages/app/*"
      ],
      "react-native": [
        "./node_modules/react-native"
      ],
      "react-native/*": [
        "./node_modules/react-native/*"
      ]
    }
  },
  "include": [
    "**/*",
    "../../packages/app/global.d.ts",
    "nativewind-env.d.ts"
  ]
}