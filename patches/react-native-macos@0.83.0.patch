diff --git a/React/Fabric/Mounting/ComponentViews/ScrollView/RCTEnhancedScrollView.mm b/React/Fabric/Mounting/ComponentViews/ScrollView/RCTEnhancedScrollView.mm
--- a/React/Fabric/Mounting/ComponentViews/ScrollView/RCTEnhancedScrollView.mm
+++ b/React/Fabric/Mounting/ComponentViews/ScrollView/RCTEnhancedScrollView.mm
@@ -49,5 +49,8 @@
     self.automaticallyAdjustsContentInsets = NO;
     self.hasHorizontalScroller = YES;
     self.hasVerticalScroller = YES;
+    // Match the Fabric prop default so an explicit false works on first mount.
+    self.verticalScrollElasticity = NSScrollElasticityNone;
+    self.horizontalScrollElasticity = NSScrollElasticityNone;
     self.autohidesScrollers = YES;
 #endif // macOS]
@@ -61,6 +64,27 @@
 
   return self;
 }
+
+#if TARGET_OS_OSX // [macOS]
+- (void)scrollWheel:(NSEvent *)event
+{
+  if (!self.isScrollEnabled) {
+    [[self nextResponder] scrollWheel:event];
+    return;
+  }
+
+  CGSize viewportSize = self.contentView.bounds.size;
+  BOOL scrollsHorizontally = self.contentSize.width > viewportSize.width + 1.0;
+  BOOL scrollsVertically = self.contentSize.height > viewportSize.height + 1.0;
+
+  if (scrollsHorizontally && !scrollsVertically && fabs(event.scrollingDeltaY) > fabs(event.scrollingDeltaX)) {
+    [[self nextResponder] scrollWheel:event];
+    return;
+  }
+
+  [super scrollWheel:event];
+}
+#endif // macOS
 
