@@ -61,6 +61,27 @@ - (instancetype)initWithFrame:(CGRect)frame
   return self;
 }
 
+#if TARGET_OS_OSX // [macOS]
+- (void)scrollWheel:(NSEvent *)event
+{
+  if (!self.isScrollEnabled) {
+    [[self nextResponder] scrollWheel:event];
+    return;
+  }
+
+  CGSize viewportSize = self.contentView.bounds.size;
+  BOOL scrollsHorizontally = self.contentSize.width > viewportSize.width + 1.0;
+  BOOL scrollsVertically = self.contentSize.height > viewportSize.height + 1.0;
+
+  if (scrollsHorizontally && !scrollsVertically && fabs(event.scrollingDeltaY) > fabs(event.scrollingDeltaX)) {
+    [[self nextResponder] scrollWheel:event];
+    return;
+  }
+
+  [super scrollWheel:event];
+}
+#endif // macOS
